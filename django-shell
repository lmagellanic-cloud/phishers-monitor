#!/bin/sh
set -eu

PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PYTHON="$PROJECT_ROOT/venv/bin/python"

if [ ! -x "$PYTHON" ]; then
    printf 'No se encontro el interprete del proyecto: %s\n' "$PYTHON" >&2
    exit 1
fi

if [ "$#" -gt 0 ]; then
    exec "$PYTHON" "$PROJECT_ROOT/django_backend/manage.py" shell "$@"
fi

exec "$PYTHON" "$PROJECT_ROOT/django_backend/cli.py"